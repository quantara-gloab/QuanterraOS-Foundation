[Unit]
Description=QuanterraOS web application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=quanterraos
Group=quanterraos
WorkingDirectory=/opt/quanterraos/app
EnvironmentFile=/opt/quanterraos/app/.env
Environment=NODE_ENV=production
Environment=PORT=3102
ExecStart=/usr/bin/node --experimental-strip-types src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target