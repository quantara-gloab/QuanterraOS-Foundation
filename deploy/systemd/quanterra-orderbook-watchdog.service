[Unit]
Description=QuanterraOS order-book watchdog and collector supervisor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=quanterraos
Group=quanterraos
WorkingDirectory=/opt/quanterraos/app
EnvironmentFile=/opt/quanterraos/app/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/orderbook-watchdog.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target