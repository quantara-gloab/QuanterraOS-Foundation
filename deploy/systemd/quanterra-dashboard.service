[Unit]
Description=QuanterraOS internal spread dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=quanterraos
Group=quanterraos
WorkingDirectory=/opt/quanterraos/app
EnvironmentFile=/opt/quanterraos/app/.env
Environment=NODE_ENV=production
Environment=DASHBOARD_PORT=3000
ExecStart=/usr/bin/node src/dashboard-server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target