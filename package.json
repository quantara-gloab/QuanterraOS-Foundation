{
  "name": "quanterraos-foundation",
  "version": "0.1.0",
  "description": "Composite currency index + edge-score foundation for QuanterraOS",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "db:init": "node --experimental-strip-types scripts/initialize-db.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "ingest": "node --experimental-strip-types src/ingest.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 src/__tests__/*.ts",
    "test:highlow": "node --experimental-strip-types --test src/__tests__/falcon-highlow.test.ts",
    "test:jev": "node --experimental-strip-types --test src/__tests__/falcon-jev.test.ts",
    "test:growth": "node --experimental-strip-types --test src/__tests__/growth.test.ts",
    "growth:supervisor": "node --experimental-strip-types scripts/run-supervisor.ts",
    "growth:import": "node --experimental-strip-types scripts/import-prospects.ts",
    "growth:verify": "node --experimental-strip-types scripts/verify-ledger.ts",
    "backtest:highlow": "node --experimental-strip-types src/highlow-backtest.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^4.19.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
